# Mako Notification Daemon Configuration - Amber Rice Edition
max-visible=5
sort=-time
layer=overlay
anchor=top-right

# Geometry
width=360
height=120
margin=14
padding=14,16
border-size=2
border-radius=10
icons=1
max-icon-size=48
icon-location=left

# Colors & Fonts
font=JetBrainsMono Nerd Font 10
background-color=#0a0704f2
text-color=#f5dfc8
border-color=#ffb040
progress-color=source #ffb040

# Behavior
default-timeout=6000
ignore-timeout=0

# Actions
[action]
border-color=#ffd080

# Urgency Levels
[urgency=low]
background-color=#0a0704ea
border-color=#7a5840
text-color=#c8a888
default-timeout=3500

[urgency=normal]
background-color=#0a0704f2
border-color=#ffb040
text-color=#f5dfc8
default-timeout=6000

[urgency=high]
background-color=#150604f6
border-color=#ff453a
text-color=#ffebe8
default-timeout=0

