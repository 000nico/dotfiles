max-visible=5
sort=-time
layer=overlay
anchor=top-right

width=340
height=110
margin=12
padding=10,14
border-size=1
border-radius=0
icons=1
max-icon-size=40
icon-location=left

font=JetBrainsMono Nerd Font 10
background-color=#18202bf2
text-color=#d9f0ff
border-color=#8fc8e8
progress-color=source #8fc8e8

default-timeout=4000
ignore-timeout=1

on-button-left=dismiss
on-button-middle=dismiss-all
on-button-right=dismiss-all
on-touch=dismiss

[actionable]
border-color=#8fc8e8

[urgency=low]
background-color=#18202bea
border-color=#504945
text-color=#9bb9cc
default-timeout=2500

[urgency=normal]
background-color=#18202bf2
border-color=#8fc8e8
text-color=#d9f0ff
default-timeout=4000

[urgency=high]
background-color=#281414f8
border-color=#ff8fa3
text-color=#fee2e2
default-timeout=7000
