# Mako Notification Daemon Configuration - Purple Dark Edition
max-visible=5
sort=-time
layer=overlay
anchor=top-right

# Geometry
width=360
height=120
margin=14
padding=14,16
border-size=2
border-radius=10
icons=1
max-icon-size=48
icon-location=left

# Colors & Fonts
font=JetBrainsMono Nerd Font 10
background-color=#080512f2
text-color=#e9d5ff
border-color=#c084fc
progress-color=source #c084fc

# Behavior
default-timeout=6000
ignore-timeout=0

# Actions
[actionable]
border-color=#d8b4fe

# Urgency Levels
[urgency=low]
background-color=#080512ea
border-color=#4c1d95
text-color=#b8a0d8
default-timeout=3500

[urgency=normal]
background-color=#080512f2
border-color=#c084fc
text-color=#e9d5ff
default-timeout=6000

[urgency=high]
background-color=#0d0518f6
border-color=#f87171
text-color=#fee2e2
default-timeout=0

