#!/usr/bin/env bash
# Brillo del panel + OSD con wob.
# uso: bri up | bri down
set -uo pipefail

STEP=5
FIFO="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wob.sock"

backlight_dir() {
    local d
    for d in /sys/class/backlight/*/; do
        [ -w "$d/brightness" ] || continue
        echo "${d%/}"
        return 0
    done
    return 1
}

show() {
    local pct
    pct=$(awk -v c="$1" -v m="$2" 'BEGIN { if (m>0) printf "%d", int(c*100/m+0.5); else print 0 }')
    printf '%s\n' "$pct" > "$FIFO" 2>/dev/null
}

case "${1:-}" in
    up|down)
        dir=+; [[ "${1:-}" == down ]] && dir=-
        if command -v brightnessctl >/dev/null 2>&1; then
            brightnessctl set "${STEP}%"$dir >/dev/null 2>&1
            max=$(brightnessctl max 2>/dev/null | awk '{print $1}')
            cur=$(brightnessctl get 2>/dev/null | awk '{print $1}')
        else
            d=$(backlight_dir) || exit 1
            max=$(<"$d/max_brightness")
            cur=$(<"$d/brightness")
            step=$(( max * STEP / 100 )); (( step < 1 )) && step=1
            if [[ "$dir" == "+" ]]; then
                new=$((cur + step))
            else
                new=$((cur - step))
            fi
            (( new < 0 )) && new=0
            (( new > max )) && new=$max
            printf '%s\n' "$new" >"$d/brightness" 2>/dev/null || exit 1
            cur=$new
        fi
        show "${cur:-0}" "${max:-0}"
        ;;
    *)
        echo "uso: $(basename "$0") up|down" >&2; exit 2 ;;
esac