#!/usr/bin/env bash
set -u

PIDFILE="/run/user/$(id -u)/dur-screensaver-kitty.pid"

if [ -r "$PIDFILE" ]; then
    while IFS= read -r pid; do
        case "$pid" in
            ''|*[!0-9]*) ;;
            *) kill "$pid" 2>/dev/null || true ;;
        esac
    done <"$PIDFILE"
    rm -f "$PIDFILE"
fi
