#!/usr/bin/env bash
set -u

PIDFILE="/run/user/$(id -u)/dur-screensaver-kitty.pid"
PLAYER="${HOME}/.local/bin/dur-screensaver-player"

if /usr/bin/playerctl -a status 2>/dev/null | /usr/bin/grep -qx 'Playing'; then
    exit 0
fi

if [ -r "$PIDFILE" ]; then
    while IFS= read -r old_pid; do
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            exit 0
        fi
    done <"$PIDFILE"
    rm -f "$PIDFILE"
fi

launch() {
    /usr/bin/kitty \
    --single-instance=no \
    --class LyDurScreensaver \
    --title LyDurScreensaver \
    --start-as=fullscreen \
    --override font_family='JetBrainsMono Nerd Font' \
    --override bold_font='JetBrainsMono Nerd Font' \
    --override font_size=9.7 \
    --override window_padding_width=0 \
    --override background_opacity=1 \
    "$PLAYER" &
    printf '%s\n' "$!" >>"$PIDFILE"
}

monitor_names="$(/usr/bin/mmsg get all-monitors | /usr/bin/python3 -c '
import json, sys
monitors = json.load(sys.stdin)["monitors"]
print(*[monitor["name"] for monitor in monitors], sep="\n")
')"
while IFS= read -r monitor_name; do
    [ -n "$monitor_name" ] || continue
    /usr/bin/mmsg dispatch "focusmon,$monitor_name"
    launch
    /usr/bin/sleep 0.3
    /usr/bin/mmsg dispatch "tagmon,$monitor_name"
done <<EOF
$monitor_names
EOF
