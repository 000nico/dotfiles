[general]
framerate = 30
bars = 64
bar_width = 1
bar_spacing = 0
autosens = 1
sleep_timer = 0

[input]
method = pulse
source = alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Speaker__sink.monitor

[output]
method = raw
raw_target = /tmp/cava.fifo
data_format = ascii
ascii_max_range = 7
bar_delimiter = 59
frame_delimiter = 10

[smoothing]
noise_reduction = 85
