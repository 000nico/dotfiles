// Niri configuration - Aesthetic Square Dark Theme
// Documentation: https://niri-wm.github.io/niri/

input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }

    touchpad {
        tap
    }

    mouse {
    }

    warp-mouse-to-focus
    focus-follows-mouse
}

// Layout & Decorations
layout {
    gaps 8
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 2
        active-color "#9bdcff"
        inactive-color "#30485aaa"
        urgent-color "#ff8fa3"
    }

    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=4
        color "#00000080"
    }
}

blur {
    passes 3
    offset 3
    noise 0.03
    saturation 1.15
}

window-rule {
    match app-id=r#"^(kitty|kitty-yazi|vesktop|codium|VSCodium|spotify|spotify-tui|org\.gnome\.Nautilus|nautilus|org\.pwmt\.zathura|pavucontrol|blueman-manager)$"#
    opacity 0.70
    background-effect {
        blur true
    }
}

window-rule {
    match app-id=r#"^(firefox|librewolf)$"#
    opacity 0.93
    background-effect {
        blur true
        saturation 1.05
    }
}

window-rule {
    match app-id=r#"^fuzzel$"#
    opacity 0.75
    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="^fuzzel$"
    opacity 0.75
    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=6
        color "#00000080"
    }
    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 1.2
    }
}

// Autostart processes
spawn-at-startup "quickshell" "--path" "/home/nico/dotfiles/quickshell"
spawn-at-startup "/home/nico/.config/niri/wallpaper-by-theme.sh"
spawn-at-startup "/home/nico/.config/niri/clipboard-watch.sh"
spawn-sh-at-startup "dbus-update-activation-environment --systemd --all"
spawn-sh-at-startup "xhost +SI:localuser:root 2>/dev/null || true"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 1.0
}

// Window rules - Strict Square Aesthetics (radius 0)
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^(firefox|librewolf)$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"^(pavucontrol|org\.pulseaudio\.pavucontrol|blueman-manager|nm-connection-editor|satty)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(xdg-desktop-portal-gtk|xdg-desktop-portal-gnome|hyprland-share-picker)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(librewolf|firefox|codium|vscodium|VSCodium|jetbrains-.*|idea|org\.gnome\.Nautilus|nautilus|vesktop|Vesktop)$"#
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id=r#"^spotify-tui$"#
    default-column-width { proportion 0.66667; }
}

binds {
    // Hotkey overlay & Inhibit
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Applications & Rice
    Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+C      hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+R      hotkey-overlay-title="App Launcher" { spawn "fuzzel"; }
    Mod+Space  hotkey-overlay-title="App Launcher" { spawn "fuzzel"; }
    Mod+D      hotkey-overlay-title="App Launcher" { spawn "fuzzel"; }
    Mod+W      hotkey-overlay-title="Browser" { spawn "librewolf"; }
    Mod+E      hotkey-overlay-title="File Manager (Yazi)" { spawn "kitty" "-e" "yazi"; }
    Mod+Shift+N hotkey-overlay-title="File Manager (Yazi)" { spawn "kitty" "--class" "kitty-yazi" "-e" "yazi"; }
    Mod+T      hotkey-overlay-title="Text Editor" { spawn "kitty" "-e" "nvim"; }
    Mod+S      hotkey-overlay-title="Spotify TUI" { spawn "kitty" "--class" "spotify-tui" "-e" "spt"; }
    Mod+Shift+T hotkey-overlay-title="Theme Switcher" { spawn "/home/nico/.config/waybar/scripts/theme-switcher.sh" "menu"; }
    Ctrl+Shift+Escape hotkey-overlay-title="Task Manager" { spawn "kitty" "-e" "btop"; }
    Mod+X      hotkey-overlay-title="Power Menu" { spawn "/home/nico/.config/waybar/scripts/wofi-power.sh"; }
    Mod+L      hotkey-overlay-title="Lock Session" { spawn "loginctl" "lock-session"; }

    // Window Management
    Mod+Q      { close-window; }
    Mod+Shift+C { center-column; }
    Mod+Alt+Space { toggle-window-floating; }
    Mod+V      { toggle-window-floating; }
    Mod+F      { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M      { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }

    // Focus navigation
    Mod+Left   { focus-column-left; }
    Mod+Right  { focus-column-right; }
    Mod+Up     { focus-window-up; }
    Mod+Down   { focus-window-down; }
    Mod+H      { focus-column-left; }
    Mod+K      { focus-window-up; }
    Mod+J      { focus-window-down; }
    Alt+Tab    { focus-column-right; }
    Mod+Tab    { focus-column-right; }

    // Window movement
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }

    // Column resizing & width presets
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+R { switch-preset-column-width; }
    Mod+Ctrl+R { reset-window-height; }

    // Column window grouping (consume/expel)
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Ctrl+Left  { focus-workspace-down; }
    Mod+Ctrl+Right { focus-workspace-up; }
    Mod+Page_Down  { focus-workspace-down; }
    Mod+Page_Up    { focus-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // Overview
    Mod+O repeat=false { toggle-overview; }

    // Screenshots
    Print      { spawn "/home/nico/.config/niri/screenshot.sh" "region"; }
    Mod+Print  { spawn "/home/nico/.config/niri/screenshot.sh" "screen"; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Hardware Controls (Volume, Brightness, Media)
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }

    // Quit session
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
}
