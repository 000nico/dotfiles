#!/usr/bin/env bash
set -u

PIDFILE="/run/user/$(id -u)/dur-screensaver-kitty.pid"
PLAYER="${HOME}/.local/bin/dur-screensaver-player"
UMBRIEL="${HOME}/.local/bin/umbriel"
# A 1:2 cell font keeps the 240x67 animation at its intended aspect ratio.
FONT="Liberation Mono"
FONT_SIZE="9.9"

# Never cover the screen while music or a video is playing.
if /usr/bin/playerctl -a status 2>/dev/null | /usr/bin/grep -qx 'Playing'; then
    exit 0
fi

# One screensaver window per monitor; bail out if one is already running.
if [ -r "$PIDFILE" ]; then
    while IFS= read -r old_pid; do
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            exit 0
        fi
    done <"$PIDFILE"
    rm -f "$PIDFILE"
fi

launch() {
    # kitty asks for fullscreen itself (Umbriel logs request_fullscreen), so no
    # compositor round-trip is needed to size the window.
    /usr/bin/kitty \
        --single-instance=no \
        --class LyDurScreensaver \
        --title LyDurScreensaver \
        --start-as=fullscreen \
        --override font_family="$FONT" \
        --override bold_font="$FONT" \
        --override font_size="$FONT_SIZE" \
        --override window_padding_width=0 \
        --override background_opacity=1 \
        "$PLAYER" &
    printf '%s\n' "$!" >>"$PIDFILE"
}

mapfile -t monitor_names < <(
    "$UMBRIEL" outputs 2>/dev/null | /usr/bin/awk '/^[^[:space:]]/ {print $1}'
)
[ "${#monitor_names[@]}" -gt 0 ] || exit 0

for i in "${!monitor_names[@]}"; do
    # New windows open on the focused monitor, so walk the outputs in order.
    if [ "$i" -gt 0 ]; then
        "$UMBRIEL" msg output-focus-next >/dev/null 2>&1
    fi
    launch
    /usr/bin/sleep 0.3
done
