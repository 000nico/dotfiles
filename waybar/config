{
	"mode": "dock",
	"position": "top",
	"layer": "top",
	"height": 26,
	"margin-top": 4,
	"margin-left": 6,
	"margin-right": 6,
	"spacing": 0,
	"reload_style_on_change": true,

	"include": [
		"~/.config/waybar/modules/custom/*.jsonc",
		"~/.config/waybar/modules/niri/*.jsonc",
		"~/.config/waybar/modules/*.jsonc"
	],

	"modules-left": [
		"custom/distro",
		"custom/themeswitcher",
		"niri/workspaces",
		"mpris"
	],

	"modules-center": [
		"clock#time",
		"clock#date"
	],

	"modules-right": [
		"cpu",
		"memory",
		"group/pulseaudio",
		"backlight",
		"battery",
		"custom/power"
	]
}
