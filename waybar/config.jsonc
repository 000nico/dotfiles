{
	"mode": "dock",
	"position": "top",
	"layer": "top",
	"height": 0,
	"margin-top": 8,
	"margin-left": 10,
	"margin-right": 10,
	"spacing": 0,
	"reload_style_on_change": true,

	"include": [
		"~/.config/waybar/modules/custom/*.jsonc",
		"~/.config/waybar/modules/niri/*.jsonc",
		"~/.config/waybar/modules/*.jsonc"
	],

	"modules-left": [
		"custom/distro",
		"niri/workspaces",
		"mpris"
	],

	"modules-center": [
		"clock#time",
		"clock#date"
	],

	"modules-right": [
		"cpu",
		"memory",
		"group/pulseaudio",
		"backlight",
		"battery",
		"custom/power"
	]
}
