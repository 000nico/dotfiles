{
	"cpu": {
		"interval": 2,
		"format": "󰍛 {usage}%",
		"states": {
			"warning": 70,
			"critical": 90
		},
		"format-warning": "󰀨 {usage}%",
		"format-critical": "󰀨 {usage}%",
		"min-length": 7,
		"max-length": 7,
		"on-click": "kitty -e btop",
		"on-click-right": "kitty -e htop",
		"tooltip": true,
		"tooltip-format": "CPU Usage: {usage}%\n<i>Click: Open btop</i>"
	}
}
