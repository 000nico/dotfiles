{
	"cpu": {
		"interval": 5,
		"format": "󰍛 {usage}%",
		"states": {
			"warning": 75,
			"critical": 90
		},
		"format-warning": "󰀨 {usage}%",
		"format-critical": "󰀨 {usage}%",
		"min-length": 7,
		"max-length": 7,
		"on-click": "kitty -e btop",
		"tooltip": true,
		"tooltip-format": "CPU Usage: {usage}%"
	}
}

