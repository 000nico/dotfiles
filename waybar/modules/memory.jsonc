{
	"memory": {
		"interval": 2,
		"format": "󰘚 {percentage}%",
		"states": {
			"warning": 75,
			"critical": 90
		},
		"format-warning": "󰀧 {percentage}%",
		"format-critical": "󰀧 {percentage}%",
		"min-length": 7,
		"max-length": 7,
		"on-click": "kitty -e btop",
		"tooltip-format": "Memory Used: {used:0.1f}/{total:0.1f} GiB ({percentage}%)\n<i>Click: Open btop</i>"
	}
}
